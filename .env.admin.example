# 管理后台只在服务端配置。请复制为本地未跟踪文件，不要提交真实值。
ADMIN_ENABLED=true
ADMIN_USERNAME=jaryn
# 用 node --input-type=module -e "import { hashPassword } from './server/admin/password.js'; console.log(await hashPassword(process.env.ADMIN_PASSWORD))" 生成。
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$REPLACE_SALT$REPLACE_DERIVED_KEY
ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# HTTPS 部署设为 true；本地 HTTP 测试设为 false。
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS=5

# 可选构建标识；未提供时后台显示未知。
APP_BUILD_VERSION=
APP_BUILD_COMMIT=
