# 仅在服务端配置。复制为 .env.local 时不要提交该文件。
BLESSINGS_ENABLED=true
BLESSINGS_DATABASE_URL=postgresql://wedding_app:REPLACE_PASSWORD@DATABASE_HOST:5432/wedding
BLESSINGS_DB_SSL=true
# 私有 CA 可将 PEM 换行写为 \n；使用系统信任证书时留空。
BLESSINGS_DB_CA_PEM=
BLESSINGS_RATE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BLESSINGS_PUBLIC_ORIGIN=https://wedding.jaryn.com.cn
BLESSINGS_ROOM=wedding-20261017
# 两个池共用此上限；实际值受总预算约束，每实例另有一个 LISTEN 连接。
WEDDING_MAX_INSTANCES=10
WEDDING_DB_CONNECTION_BUDGET=80
BLESSINGS_DB_POOL_SIZE=3
BLESSINGS_MAX_STREAMS=500
# 仅在网关会覆盖此请求头时配置；未配置时使用直连地址。
BLESSINGS_CLIENT_IP_HEADER=
BLESSINGS_CLIENT_LIMIT=12
BLESSINGS_NETWORK_LIMIT=600
BLESSINGS_MIN_INTERVAL_MS=3000
