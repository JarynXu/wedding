# 仅放在服务端。数据库复用已配置的 BLESSINGS_DATABASE_URL 等参数。
GAME_ENABLED=true
# 两个值须保持跨实例一致；DATA_KEY 用于已存手机号和兑奖码，不能随意更换。
GAME_DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GAME_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 阿里云号码认证的短信认证服务，不能使用普通短信 SendSms 接口。
GAME_ALIYUN_ACCESS_KEY_ID=
GAME_ALIYUN_ACCESS_KEY_SECRET=
GAME_SMS_SIGN_NAME=
GAME_SMS_TEMPLATE_CODE=
GAME_SMS_SCHEME_NAME=wedding-game
GAME_SMS_DAILY_LIMIT=300
GAME_CAPTCHA_APP_ID=
GAME_CAPTCHA_APP_KEY=

# deepseek 使用 JSON Output；openai-compatible 使用 JSON Schema。
GAME_AI_PROVIDER=deepseek
# DeepSeek 填 https://api.deepseek.com，两个模型均可填 deepseek-flash。
# 暂不启用AI时，下方四项均留空。
GAME_AI_BASE_URL=
GAME_AI_API_KEY=
GAME_AI_MODEL=
GAME_AI_REVIEW_MODEL=
